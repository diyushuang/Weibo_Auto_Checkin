# ============================================================
# 微博签到管理面板 · Docker 部署环境变量
# 复制为 .env 后按需修改（.env 已被 .gitignore 忽略，不会提交）
# ============================================================

# ---- 服务端口 ----
WCM_PORT=8000

# ---- 管理员账号（首次启动创建，之后不再改）----
# 留空则不在启动时创建管理员，首次访问网页时通过「初始化页」设置
WCM_ADMIN_USER=admin
WCM_ADMIN_PASSWORD=

# ---- 镜像名（install.sh / docker compose 用）----
WCM_IMAGE=kaoqy666/weibo-checkin:latest

# ---- 数据目录（挂载到容器内 /app/data）----
WCM_DATA_DIR=/opt/weibo-checkin/data

# ---- 反向代理 ----
# 部署在 nginx 等可信反代之后（尤其 HTTPS 卸载）时设为 1：
# 1) 登录限流将采信 X-Forwarded-For 取真实客户端 IP；
# 2) HTTPS 访问时会话 Cookie 正确附加 Secure 标记。
# 面板直接暴露公网时务必保持 0（默认），否则限流可被伪造 XFF 绕过。
WCM_TRUST_PROXY=0
